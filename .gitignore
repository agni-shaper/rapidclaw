# Bot-instance state — never tracked, written by bot-init.sh / runtime
.env
.bot-setup-state.json
.bot-config.yml

# Listener dependencies
accountability/listener/node_modules/

# Linked sites (each bot links the projects it owns)
# Symlinks are gitignored because they're per-machine paths.
# Pointer .md files (sites/<name>.md) ARE tracked — they document where to
# find a site that isn't symlinked yet (e.g. repo not located, brand TBD).
sites/*
!sites/*.md

# Reminders / wishlist sqlite + runtime state
accountability/reminders/*.db
accountability/reminders/*.db-journal
accountability/wishlist/*.db
accountability/wishlist/*.db-journal

# Routine state (per-day JSON cache / proposals / sentinels)
# sqlite (Phase 3) owns these going forward; the .archive/ dir
# keeps the pre-cutover files locally as a backup but doesn't track them.
accountability/state/
marketing/.state/

# Ephemeral screenshots from browser-use scans
accountability/engagement-screenshots/

# sed -i.bak backup files
*.bak

# Claude Code session-local state
.claude/scheduled_tasks.lock

# OS / editor noise
.DS_Store
.vscode/
.idea/
Thumbs.db

# Studio (if present, Next.js build artifacts)
studio/node_modules/
studio/.next/
studio/.turbo/
studio/out/
studio/coverage/

# Local routine output (raw blog generations, etc.)
output/

# marketing-automation runtime state (sentinels, build artifacts, helper scripts)
marketing/.state/
